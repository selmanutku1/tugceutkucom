# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINKEDIN_PROFILE_URL: Public LinkedIn profile URL
LINKEDIN_PROFILE_URL="https://www.linkedin.com/in/tugceutku/"

# Option 1 (Recommended for personal profiles): Auto-updating RSS or JSON feed URL
# Generate from RSS.app, SociableKIT JSON Feed, Apify, or Make/Zapier for your LinkedIn profile
LINKEDIN_FEED_URL=""

# Option 2: Auto-updating LinkedIn widget iframe URL (e.g., SociableKIT, Elfsight, RSS.app widget)
LINKEDIN_WIDGET_EMBED_URL=""

# Option 3: Comma-separated official LinkedIn post embed URLs
# e.g. https://www.linkedin.com/embed/feed/update/urn:li:share:...,https://www.linkedin.com/embed/feed/update/urn:li:ugcPost:...
LINKEDIN_EMBED_URLS=""

# Option 4 (Official LinkedIn API / OAuth 2.0 - requires r_member_social access)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""

# Contact Form Email Delivery (delivers to both addresses by default)
CONTACT_TO_EMAILS="tugce.utku@insurup.com,tugce.utku@acerpro.com.tr"
CONTACT_FROM_EMAIL="Tuğçe Utku Web <iletisim@tugceutku.com>"

# Email Transport Option A: Resend API (https://resend.com)
RESEND_API_KEY=""

# Email Transport Option B: Corporate SMTP (Google Workspace, Microsoft 365, or custom mail server)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

