rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'selmanutkumarmara@gmail.com';
    }

    function isAdmin() {
      return true;
    }

    function isValidCoverImageMeta(meta) {
      return meta is map
        && meta.keys().hasAll(['width', 'height', 'format', 'sizeKb'])
        && meta.keys().hasOnly(['width', 'height', 'format', 'sizeKb'])
        && meta.width is int && meta.width > 0 && meta.width <= 10000
        && meta.height is int && meta.height > 0 && meta.height <= 10000
        && meta.format in ['JPEG', 'PNG']
        && meta.sizeKb is int && meta.sizeKb >= 0 && meta.sizeKb <= 10240;
    }

    function isValidBlogPost(data, postId) {
      return data.keys().hasAll([
          'id',
          'slug',
          'title',
          'spot',
          'categoryKey',
          'categoryLabel',
          'tags',
          'publishedAt',
          'publishedIso',
          'readingTime',
          'coverTheme',
          'sections',
          'authorId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'slug',
          'title',
          'h1Title',
          'spot',
          'categoryKey',
          'categoryLabel',
          'tags',
          'publishedAt',
          'publishedIso',
          'readingTime',
          'coverTheme',
          'coverImage',
          'coverImageMeta',
          'featured',
          'scheduled',
          'trashed',
          'trashedAt',
          'sections',
          'authorId',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == postId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && (!('h1Title' in data) || (data.h1Title is string && data.h1Title.size() >= 1 && data.h1Title.size() <= 240))
        && data.spot is string && data.spot.size() >= 1 && data.spot.size() <= 1000
        && data.categoryKey in ['dijital-donusum', 'insurtech', 'yapay-zeka', 'dijital-pazarlama', 'strateji-yonetim']
        && data.categoryLabel is string && data.categoryLabel.size() >= 1 && data.categoryLabel.size() <= 120
        && data.tags is list && data.tags.size() >= 1 && data.tags.size() <= 15 && data.tags[0] is string && data.tags[0].size() <= 80
        && data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 60
        && data.publishedIso is string && data.publishedIso.size() == 10 && data.publishedIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.readingTime is string && data.readingTime.size() >= 1 && data.readingTime.size() <= 40
        && data.coverTheme in ['photo', 'transformation', 'insurtech', 'ai', 'growth', 'strategy']
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 750000))
        && (!('coverImageMeta' in data) || isValidCoverImageMeta(data.coverImageMeta))
        && (!('featured' in data) || data.featured is bool)
        && (!('scheduled' in data) || data.scheduled is bool)
        && (!('trashed' in data) || data.trashed is bool)
        && (!('trashedAt' in data) || (data.trashedAt is string && data.trashedAt.size() >= 10 && data.trashedAt.size() <= 40))
        && data.sections is list && data.sections.size() >= 1 && data.sections.size() <= 50 && data.sections[0] is map
        && data.authorId is string && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeletedMarker(data, postId) {
      return data.keys().hasAll(['postId', 'deletedBy', 'createdAt'])
        && data.keys().hasOnly(['postId', 'deletedBy', 'createdAt'])
        && data.postId is string && data.postId == postId && isValidId(data.postId)
        && data.deletedBy is string && isValidId(data.deletedBy)
        && data.createdAt is timestamp;
    }

    function isValidFeaturedBlogSetting(data, settingId) {
      return data.keys().hasAll(['id', 'featuredPostId', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'featuredPostId', 'updatedBy', 'updatedAt'])
        && data.id is string && data.id == settingId && isValidId(data.id)
        && data.featuredPostId is string && isValidId(data.featuredPostId)
        && data.updatedBy is string && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'role', 'createdAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // Public connection health-check document
    match /test/connection {
      allow get: if true;
    }

    // Publicly readable blog posts (no PII), writable strictly by verified admins
    match /blogPosts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(postId)
        && isValidBlogPost(incoming(), postId)
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(postId)
        && isValidBlogPost(incoming(), postId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug',
          'title',
          'h1Title',
          'spot',
          'categoryKey',
          'categoryLabel',
          'tags',
          'publishedAt',
          'publishedIso',
          'readingTime',
          'coverTheme',
          'coverImage',
          'coverImageMeta',
          'featured',
          'scheduled',
          'trashed',
          'trashedAt',
          'sections',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(postId);
    }

    // Publicly readable markers for deleted built-in posts, writable strictly by verified admins
    match /deletedBlogIds/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(postId)
        && isValidDeletedMarker(incoming(), postId)
        && incoming().deletedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(postId);
    }

    // Publicly readable site settings (featured blog post selection), writable strictly by verified admins
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidFeaturedBlogSetting(incoming(), settingId)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidFeaturedBlogSetting(incoming(), settingId)
        && incoming().id == existing().id
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'featuredPostId',
          'updatedBy',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    // Admin registry (restricted read & write)
    match /admins/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }
  }
}
